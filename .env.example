# amoCRM Forms Integration (1-6)
AMO_FORM_OBREZKA_ID=1740986
AMO_FORM_OBREZKA_HASH=cb3d3a939fa02c88d64b58894dbb50c9
AMO_FORM_SERVICE_ID=1740990
AMO_FORM_SERVICE_HASH=91d037a44917d4d614204a2c38e19646
AMO_FORM_DEFAULT_ID=1259566
AMO_FORM_DEFAULT_HASH=169e0aa6a68725a7ee2241488dd4fb68

# amoCRM OAuth API Integration (7-11)
AMO_SUBDOMAIN=yoursubdomain
AMO_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AMO_CLIENT_SECRET=your_client_secret_hash
AMO_REFRESH_TOKEN=your_refresh_token_here
AMO_REDIRECT_URI=https://gardeners-agro.netlify.app/api/amo/callback

# Google Sheets Integration
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"..."}

# Database URL
# If using PgBouncer / Prisma Accelerate, append: ?pgbouncer=true&connection_limit=1
# If direct connection, connection_limit=5 is recommended (e.g. postgresql://user:password@localhost:5432/gardeners?connection_limit=5)
DATABASE_URL=postgresql://user:password@localhost:5432/gardeners

# Scheduled Fines Execution Threshold (default 23:55 MSK)
FINES_RUN_HOUR_MS=23
FINES_RUN_MINUTE_MS=55

# Other environment variables
JWT_SECRET=your_jwt_secret_key
CRON_SECRET=your_cron_secret_key
SITE_URL=https://gardeners-agro.netlify.app
DISPATCHER_VK_ID=123456789
VK_GROUP_TOKEN=vk_group_access_token
VK_CONFIRMATION_CODE=vk_confirmation_code
VK_CALLBACK_SECRET=vk_callback_secret
YANDEX_DISK_LOGIN=your_yandex_login
YANDEX_DISK_APP_PASSWORD=your_yandex_app_password
# Emergency kill-switch for Yandex.Disk backup upload (default false)
YANDEX_DISK_DISABLED=false

# Local uploads directory and disk space threshold (defaults: /opt/anemon/uploads and 2000 MB)
UPLOADS_DIR=/opt/anemon/uploads
MIN_FREE_MB=2000

# Web Push VAPID Keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@example.com
