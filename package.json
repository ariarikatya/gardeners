{
  "name": "gardeners",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/gen-sw-version.js",
    "dev": "node scripts/gen-sw-version.js && next dev",
    "build": "prisma generate && node -e \"if (!process.env.SKIP_DB_PUSH) require('child_process').execSync('prisma db push --accept-data-loss', { stdio: 'inherit' })\" && next build",
    "deploy": "rm -rf .next && npm run build && pm2 reload anemon --update-env && npm run warmup-offline-cache",
    "warmup-offline-cache": "node scripts/warmup-offline-cache.js",
    "set-manager-password": "node scripts/set-manager-password.js",
    "start": "next start",
    "postinstall": "prisma generate",
    "test:fines-logic": "node scripts/test-fines-logic.js",
    "test:reminders-logic": "node scripts/test-reminders-logic.js",
    "test:scheduled-scripts": "node scripts/test-scheduled-scripts.js",
    "test:amo-dedupe": "node scripts/test-amo-contact-dedupe.js",
    "test:money-split": "node scripts/test-money-split.js",
    "test:stop-day-edit": "node scripts/test-stop-day-edit.js",
    "test:fine-edit-delete": "node scripts/test-fine-edit-delete.js",
    "test:offline-queue": "node scripts/test-offline-queue.js",
    "test:auction-filter": "node scripts/test-auction-filter.js",
    "test:push-sw-version": "node scripts/test-push-sw-version.js",
    "test:push-pwa-env": "node scripts/test-push-pwa-env.js && node scripts/test-push-pwa-modal-gating.js",
    "test:push-logs": "node scripts/test-push-logs.js",
    "test:push-btn-reactive": "node scripts/test-push-btn-reactive.js",
    "test:push-modal-btn-sync": "node scripts/test-push-modal-btn-sync.js",
    "test:emergency-overlay-once": "node scripts/test-emergency-overlay-once.js",
    "test:push-update-safety": "node scripts/test-push-update-safety.js",
    "test:push-rebind": "node scripts/test-push-rebind.js",
    "test:uploads": "node scripts/test-uploads.js",
    "test:uploads-mixed": "node scripts/test-uploads-mixed-ui.js",
    "test:upload-image": "node scripts/upload-image.test.js",
    "test:yandex": "node scripts/test-yandex-queue.js && node scripts/test-yandex-upload-isolation.js",
    "test:yandex-queue": "node scripts/test-yandex-queue.js",
    "test:yandex-upload-isolation": "node scripts/test-yandex-upload-isolation.js",
    "test:jwt": "node scripts/test-jwt-sliding.js",
    "test:manager-password": "node scripts/test-manager-password.js",
    "test:logout": "node scripts/test-logout.js",
    "test:login-flow": "node scripts/test-login-flow.js",
    "test:gardener-expenses": "node scripts/test-gardener-expenses-all-time.js",
    "test:gardener-all-operations": "node scripts/test-gardener-all-operations.js",
    "test:install-notif-guide-modal": "node scripts/test-install-notif-guide-modal.js",
    "test:leader-period-filter": "node scripts/test-leader-period-filter.js",
    "test:offline-login": "node scripts/test-offline-saved-phone-login.js",
    "test:month-cache": "node scripts/test-month-cache-persistence.js",
    "test:sw-appshell": "node scripts/test-sw-appshell.js",
    "test:sw-offline-navigate": "node scripts/test-sw-offline-navigate.js",
    "test:offline-reliability": "node scripts/test-month-cache-persistence.js && node scripts/test-cache-isolation-and-tz.js && node scripts/test-three-month-cache.js && node scripts/test-leader-range-cache.js && node scripts/test-comment-queue-squash.js && node scripts/test-multi-account-offline.js && node scripts/test-logout-scopes-one-account.js && node scripts/test-self-healing-and-multicomment.js && node scripts/test-incremental-and-scoped.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "check-disk-space": "^3.4.0",
    "googleapis": "^140.0.1",
    "heic2any": "^0.0.4",
    "jose": "^5.0.0",
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "^0.35.5",
    "webdav": "^5.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.7",
    "web-push": "^3.6.7"
  }
}
