# Systemd service for Google Sheets hourly sync
# Copy this file to /etc/systemd/system/sync-sheets.service and adjust user/paths if needed.

[Unit]
Description=Hourly Google Sheets sync for Gardening site
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/anemon
Environment=TZ=Europe/Moscow
EnvironmentFile=/etc/gardening-site.env
ExecStart=/usr/bin/env node /opt/anemon/scripts/sync-sheets.js

[Install]
WantedBy=multi-user.target
