# Timer for run-scheduled.service — runs every 30 minutes
# Copy to /etc/systemd/system/run-scheduled.timer and enable with:
# sudo systemctl daemon-reload
# sudo systemctl enable --now run-scheduled.timer

[Unit]
Description=Timer to run scheduled tasks every 30 minutes

[Timer]
# Runs every 30 minutes to trigger 10:00 call reminders, 19:00 card reminders, and 23:55 fines
OnCalendar=*:0,30
# Also ensure a run on boot if missed
Persistent=true

[Install]
WantedBy=timers.target
