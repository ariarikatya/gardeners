# Timer for run-scheduled.service — runs every 30 minutes
# Copy to /etc/systemd/system/run-scheduled.timer and enable with:
# sudo systemctl daemon-reload
# sudo systemctl enable --now run-scheduled.timer

[Unit]
Description=Timer to run scheduled order reminders every 30 minutes

[Timer]
# OnCalendar=*:0,30 runs every 30 minutes (at 00 and 30 min of every hour).
# This covers call reminders (10:00–11:59 MSK) and card fill reminders (19:00–20:59 MSK).
OnCalendar=*:0,30
# Ensure a run on boot if missed
Persistent=true

[Install]
WantedBy=timers.target
