# Timer for run-scheduled.service — runs daily at 21:05 by default
# Copy to /etc/systemd/system/run-scheduled.timer and enable with:
# sudo systemctl daemon-reload
# sudo systemctl enable --now run-scheduled.timer

[Unit]
Description=Timer to run scheduled tasks daily

[Timer]
# OnCalendar can be adjusted as needed. Example: daily at 21:05
OnCalendar=*-*-* 21:05:00
# Also ensure a run on boot if missed
Persistent=true

[Install]
WantedBy=timers.target
