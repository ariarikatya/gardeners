# Systemd service to run scheduled order reminders for Gardening app
# Copy this file to /etc/systemd/system/run-scheduled.service and adjust user/paths if needed.

[Unit]
Description=Run scheduled order reminders for Gardening site
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# User running the service - match the owner of /opt/anemon and pm2 process (e.g. root)
User=root
# Working directory - application deployment directory
WorkingDirectory=/opt/anemon
# Ensure Moscow time zone environment
Environment=TZ=Europe/Moscow
# Environment file containing DATABASE_URL, NEXT_PUBLIC_VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT, etc.
EnvironmentFile=/etc/gardening-site.env
# ExecStart: use env node for flexibility across nvm / system Node installations
ExecStart=/usr/bin/env node /opt/anemon/scripts/run-order-reminders.js
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
