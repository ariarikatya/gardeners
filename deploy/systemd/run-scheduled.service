# Systemd service to run scheduled order reminders for Gardening app
# Copy this file to /etc/systemd/system/run-scheduled.service and adjust paths and user if needed.

[Unit]
Description=Run scheduled order reminders for Gardening site
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# User that should run the job (e.g. www-data or root)
User=www-data
# Working directory - change to actual application deployment path (e.g. /opt/anemon)
WorkingDirectory=/opt/anemon
# Environment file containing DATABASE_URL, NEXT_PUBLIC_VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT, etc.
EnvironmentFile=/etc/gardening-site.env
# ExecStart: node path to the script that runs scheduled order reminders
ExecStart=/usr/bin/node /opt/anemon/scripts/run-order-reminders.js
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
