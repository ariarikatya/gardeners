# Systemd service to run scheduled tasks for Gardening app
# Copy this file to /etc/systemd/system/run-scheduled.service and adjust paths and user.

[Unit]
Description=Run scheduled tasks for Gardening site
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# User that should run the job (change to appropriate user)
User=www-data
# Working directory - change to the path where the app is deployed
WorkingDirectory=/var/www/gardening-site/current
# Environment file containing DATABASE_URL, VK_GROUP_TOKEN, AMO_* and any other env vars
EnvironmentFile=/etc/gardening-site.env
# ExecStart: node path to the script that runs scheduled tasks
ExecStart=/usr/bin/node /var/www/gardening-site/current/scripts/run-scheduled-tasks.js
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
