datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  GARDENER
}

model User {
  id         String    @id @default(uuid())
  phone      String    @unique
  name       String
  role       Role      @default(GARDENER)
  gardenerId String?   @unique
  gardener   Gardener? @relation(fields: [gardenerId], references: [id], onDelete: Cascade)
}

model Gardener {
  id       String    @id @default(uuid())
  name     String
  phone    String    @unique
  user     User?
  orders   Order[]
  dayOffs  DayOff[]
  services Service[] @relation("GardenerServices")
  expenses Expense[]
}

model Service {
  id        String     @id @default(uuid())
  name      String     @unique
  gardeners Gardener[] @relation("GardenerServices")
  orders    Order[]
  orderLinks OrderService[]
}

model Order {
  id             String   @id @default(uuid())
  date           DateTime // Только дата (без учета времени, YYYY-MM-DD)
  dayOfWeek      String
  clientName     String
  address        String
  district       String?
  clientPhone    String
  description    String
  priceContract  Float    @default(0) // Оговоренная сумма
  priceFact      Float    @default(0) // Сумма по факту
  employeeSalary Float    @default(0) // З/п сотрудника
  companyShare   Float    @default(0) // Доля фирмы
  paymentType    String   @default("Нал") // "Нал" | "Безнал"
  paid           Boolean  @default(false) // Отмечено руководителем как выплаченное
  contactStatus  String   @default("Не связывался") // Статус звонка клиенту
  contactPenalty Float    @default(0) // Автоматический штраф за результат звонка
  status         String   @default("Новый заказ") // "Новый заказ" | "Перенос" | "Отказ" | "Выполнен" | "Отменен"
  comment        String?
  transferRequestedDate DateTime? // Желаемая дата клиента при запросе переноса от садовника
  refusalReason  String?  // Причина отказа, вводит садовник
  photoBefore    String?  // Ссылка на фото "До" (ImgBB)
  photoAfter     String?  // Ссылка на фото "После" (ImgBB)
  photoAct       String?  // Ссылка на фото акта/документа (ImgBB)
  extraPhotos    String[] @default([]) // Дополнительные фото по заказу
  gardenerId     String
  gardener       Gardener @relation(fields: [gardenerId], references: [id], onDelete: Cascade)
  serviceId      String?
  service        Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  services       OrderService[]

  @@index([date, gardenerId]) // Один садовник может иметь несколько заказов в один день
}

model OrderService {
  orderId   String
  serviceId String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([orderId, serviceId])
}

model Expense {
  id         String   @id @default(uuid())
  date       DateTime
  amount     Float
  description String
  receiptUrl String?
  gardenerId String
  gardener   Gardener @relation(fields: [gardenerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([gardenerId, date])
}

model DayOff {
  id         String   @id @default(uuid())
  date       DateTime // Только дата (YYYY-MM-DD)
  gardenerId String
  gardener   Gardener @relation(fields: [gardenerId], references: [id], onDelete: Cascade)

  @@unique([date, gardenerId]) // Выходной либо есть, либо нет — на один день одна отметка
}

model WebLead {
  id             String    @id @default(uuid())
  name           String
  phone          String
  address        String?
  comment        String?
  serviceId      String?
  preferredDate  DateTime? // Дата, которую выбрал клиент в виджете
  status         String    @default("Новая") // "Новая" | "Обработана"
  assignedTo     String?   // Имя садовника, которому назначили заказ
  createdOrderId String?   // ID реального заказа, созданного по этой заявке — чтобы "Переназначить" редактировал его, а не плодил дубли
  createdAt      DateTime  @default(now())
}
